{
  "versao_template": "1.1",
  "descricao": "Contrato de dados para o Painel Executivo CIVITAS. Índices e pontos calculados no navegador a partir das classificações.",
  "regras": {
    "pontuacao": {
      "atendido": 2,
      "parcial": 1,
      "nao_atendido": 0
    },
    "denominador": "2*(atendido+parcial+nao_atendido)",
    "excluidos": [
      "nv",
      "na",
      "criterio_pendente"
    ],
    "indice_sem_denominador": null
  },
  "campos_raiz": {
    "entidade": "string",
    "municipio": "string",
    "cnpj": "string|null",
    "data": "string",
    "instrumento": "string",
    "total": "integer",
    "dimensoes": "array[10]",
    "status": "string",
    "sintese": {
      "fortes": "array[string]",
      "atencao": "array[string]",
      "lacunas": "array[string]",
      "recomendacoes": "array[string]"
    },
    "nota": "string"
  },
  "campos_dimensao": {
    "codigo": "string",
    "nome": "string",
    "total": "integer",
    "atendido": "integer",
    "parcial": "integer",
    "nao_atendido": "integer",
    "nv": "integer",
    "na": "integer",
    "criterio_pendente": "integer"
  },
  "validacao": "Em cada dimensão, total = atendido + parcial + nao_atendido + nv + na + criterio_pendente; total geral = soma dos totais das dimensões."
}